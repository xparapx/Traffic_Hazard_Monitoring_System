# llama-server 상주 VLM (R5) — user 유닛 (~/.config/systemd/user/)
# 모델 교체형 벤치 설계: 이 유닛의 --model/--mmproj 와 기기 env 의 TRAFFIC_VLM_NAME 만
# 바꿔 재시작하면 후보가 스왑된다 (코드 수정 0). 앱쪽은 TRAFFIC_VLM=llama 로 전환.
#
# 후보 (2026-10-17 벤치 웹 확인 — 벤더 보고치, MMMU-Pro 기준):
#   A) Qwen3.5-4B    MMMU-Pro 66.3 · OCRBench 85.0 · Q4 ≈5GB — 체급 내 최강(벤더표에서
#      GPT-5-Nano·Gemini-2.5-Flash-Lite 상회). Apache-2.0, GGUF 양자화 존재.
#                                        → TRAFFIC_VLM_NAME=qwen3.5-4b-q4
#   B) Qwen3.5-9B    MMMU-Pro 70.1 · OCRBench 89.2 — 성능 2위 후보이나 Q4 ≈6GB+KV 로
#      8GB 보드에서 TRT 동거 시 스왑 0 게이트 통과가 관건. 미달 시 ↓로 교체.
#   B') Gemma-4-E4B-it  MMMU-Pro 52.6(thinking) · Q4 ≈4.9GB — 벤더 교차 비교용 대체 후보.
#                                        → TRAFFIC_VLM_NAME=gemma-4-e4b-q4
# (Gemma 4 소형은 비전 지표에서 Qwen3.5 동급에 뚜렷이 밀림 — '성능 상위 2' 원칙에 따라
#  기본 쌍은 A+B, 메모리 게이트 실패 시에만 A+B'. llama.cpp GGUF 지원은 양쪽 모두 확인.)
# 세대 확인 기록(2026-10-17, 공식 GitHub 뉴스 로그): 최신 세대는 Qwen3.8(2026-08)이지만
# 27B·2.4T 뿐 — 10B 이하 소형은 3.6/3.8 에 없음. 엣지 소형 최신 = Qwen3.5(2026-03).
# 추후 3.8 소형이 나오면 이 스왑 구조에서 파일+ENV 교체만으로 후보 갱신.
# 가중치는 ~/traffic/models/ (git 제외) — 보드에서 직접 다운로드.
#
# 필수 플래그:
#   --log-disable : 요청 로그에 base64 이미지가 남는 함정 차단 (CLAUDE.md 프라이버시)
#   -ngl 99       : 전층 GPU — 8GB 에서 TRT(YOLO)와 동거하므로 벤치에서 스왑 0 확인 필수
[Unit]
Description=traffic VLM server (llama.cpp, swappable model)
After=network.target

[Service]
WorkingDirectory=%h/traffic
ExecStart=%h/llama.cpp/build/bin/llama-server \
  --host 127.0.0.1 --port 8090 \
  --model %h/traffic/models/CURRENT.gguf \
  --mmproj %h/traffic/models/CURRENT-mmproj.gguf \
  -ngl 99 --ctx-size 4096 --log-disable
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
